# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection (required)
DATABASE_URL=postgres://bc:bc@localhost:5432/bengaluru_celebrations
# Set to true for managed Postgres that requires TLS (Neon, Supabase, RDS, etc.)
DATABASE_SSL=false

# Public base URL of the site (used in links shown to customers)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First administrator (used once by `npm run db:seed`; you can also run `npm run admin:create -- email`)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Razorpay — leave empty to use the clearly-labelled DEMO checkout (no money is collected).
# Get keys from https://dashboard.razorpay.com/app/keys (use Test Mode keys first).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you set in Razorpay Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=

# Force demo checkout on/off. Default: on only when Razorpay keys are missing.
# DEMO_PAYMENTS=false
